# Dockerfile.hooks — glibc 2.31 (Ubuntu 20.04) demo environment
# Hooks alive, no safe-linking, no aligned_OK.
#
# Build:   docker build -f Dockerfile.hooks -t heap-hooks .
# Run:     docker run --rm -it heap-hooks
# Inside:  python3 classic_exploit.py         ← shell via __free_hook
#          python3 vis_demo.py                ← plaintext 0xdeadbeef hex dump
#          nm -D /lib/x86_64-linux-gnu/libc.so.6 | grep __free_hook
#          ldd --version | head -1            ← confirm 2.31

FROM ubuntu:20.04

ENV DEBIAN_FRONTEND=noninteractive

# Repos may have moved to old-releases after standard support ended
RUN apt-get update 2>/dev/null || \
    (sed -i 's|archive.ubuntu.com|old-releases.ubuntu.com|g; \
             s|security.ubuntu.com|old-releases.ubuntu.com|g' \
        /etc/apt/sources.list && apt-get update)

RUN apt-get install -y --no-install-recommends \
        gcc libc6-dev python3 python3-pip binutils \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --no-cache-dir pwntools

WORKDIR /demo

# Copy source + exploits + vis demo into the image
COPY note.c classic_exploit.py vis_demo.py ./

# Compile the vulnerable binary (matches exploit assumptions)
RUN gcc -no-pie -fno-stack-protector -o note note.c

# Short prompt for demo clarity
ENV PS1='demo-2.31$ '

CMD ["bash"]
